APP_ENV=development
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
DB_HOST=localhost
DB_PORT=5432
DB_NAME=library
DB_USER=library
# Required: supply random values locally; no default credentials exist.
DB_PASSWORD=
DB_SSLMODE=disable
DB_SSLROOTCERT=
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m
JWT_ACCESS_SECRET=
JWT_ISSUER=library-service
JWT_AUDIENCE=library-api
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
AUTH_MAX_CONCURRENCY=4
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost:3000
SHUTDOWN_TIMEOUT=15s
OTEL_EXPORTER_OTLP_ENDPOINT=
